{#
/**
 * @file
 * Full event, rendered with the event-card component.
 *
 * On the event's own page the page title block already shows the title as
 * the h1, so the card leaves it out there.
 *
 * @see template_preprocess_node()
 */
#}
{{ include('ls_events_ui:event-card', {
  attributes: attributes,
  variant: 'full',
  heading_level: 2,
  title: page ? null : label,
  contextual_links: [title_prefix, title_suffix],
  media: content.field_event_image,
  date: content.field_event_date,
  location: content.field_event_location,
  category: content.field_event_category,
  content: content|without('field_event_image', 'field_event_date', 'field_event_location', 'field_event_category'),
}, with_context = false) }}
